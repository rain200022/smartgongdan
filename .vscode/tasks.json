{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "db: start",
      "type": "shell",
      "command": "docker compose up -d db",
      "problemMatcher": []
    },
    {
      "label": "db: migrate",
      "type": "shell",
      "command": "uv run alembic upgrade head",
      "problemMatcher": []
    },
    {
      "label": "search: seed data",
      "type": "shell",
      "command": "uv run python -m scripts.seed_search_data",
      "problemMatcher": []
    },
    {
      "label": "evaluation: search",
      "type": "shell",
      "command": "uv run python -m scripts.evaluate_search",
      "problemMatcher": []
    },
    {
      "label": "evaluation: classification pilot",
      "type": "shell",
      "command": "uv run python -m scripts.evaluate_ai --pilot",
      "problemMatcher": []
    },
    {
      "label": "api: dev",
      "type": "shell",
      "command": "uv run fastapi dev app/main.py",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "auth: create user",
      "type": "shell",
      "command": "uv run python -m scripts.create_user ${input:authUsername} --display-name \"${input:authDisplayName}\" --role ${input:authRole}",
      "problemMatcher": []
    },
    {
      "label": "frontend: install",
      "type": "shell",
      "command": "npm install",
      "options": {"cwd": "${workspaceFolder}/frontend"},
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {"cwd": "${workspaceFolder}/frontend"},
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend: quality",
      "type": "shell",
      "command": "npm run quality",
      "options": {"cwd": "${workspaceFolder}/frontend"},
      "problemMatcher": []
    },
    {
      "label": "frontend: browser tests",
      "type": "shell",
      "command": "npm run test:e2e",
      "options": {"cwd": "${workspaceFolder}/frontend"},
      "problemMatcher": []
    },
    {
      "label": "app: dev",
      "dependsOrder": "parallel",
      "dependsOn": ["api: dev", "frontend: dev"],
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "uv run pytest --cov=app --cov-fail-under=90",
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "quality: format",
      "type": "shell",
      "command": "uv run ruff format --check .",
      "problemMatcher": []
    },
    {
      "label": "quality: lint",
      "type": "shell",
      "command": "uv run ruff check .",
      "problemMatcher": []
    },
    {
      "label": "quality: types",
      "type": "shell",
      "command": "uv run mypy",
      "problemMatcher": []
    },
    {
      "label": "quality: lock",
      "type": "shell",
      "command": "uv lock --check",
      "problemMatcher": []
    },
    {
      "label": "quality: dependencies",
      "type": "shell",
      "command": "uv pip check",
      "problemMatcher": []
    },
    {
      "label": "quality: migrations",
      "type": "shell",
      "command": "uv run alembic check",
      "problemMatcher": []
    },
    {
      "label": "quality: all",
      "dependsOrder": "sequence",
      "dependsOn": [
        "quality: lock",
        "quality: format",
        "quality: lint",
        "quality: types",
        "test",
        "quality: dependencies",
        "quality: migrations",
        "frontend: quality"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "authUsername",
      "type": "promptString",
      "description": "用户名（字母、数字、点、下划线或连字符）"
    },
    {
      "id": "authDisplayName",
      "type": "promptString",
      "description": "显示名称"
    },
    {
      "id": "authRole",
      "type": "pickString",
      "description": "账号角色",
      "options": ["USER", "ENGINEER", "ADMIN"],
      "default": "USER"
    }
  ]
}
