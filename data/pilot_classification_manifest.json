      "title_template": "请协助处理：{title}",
      "description_template": "现象记录：{description}。问题仍然存在。"
    },
    {
      "id": "redacted-context",
      "title_template": "办公环境反馈：{title}",
      "description_template": "联系人 [EMAIL]，设备地址 [IP_ADDRESS]。{description}"
    },
    {
      "id": "structured-form",
      "title_template": "[故障申报] {title}",
      "description_template": "故障现象：{description}\n影响范围：当前用户。"
    }
  ]
