{
  "name": "smartgongdan-classification-robustness",
  "version": "2026-09-03-v1",
  "description": "30 条人工标注基础样例的受控表达变体，仅用于输入鲁棒性测试。",
  "variants": [
    {
      "id": "original",
      "title_template": "{title}",
