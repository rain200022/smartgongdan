{
  "name": "smart-gongdan-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "quality": "npm run lint && npm run typecheck && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "ant-design-vue": "4.2.6",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.2.1",
    "vue-tsc": "3.3.10"
  }
}
